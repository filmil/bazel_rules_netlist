load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//netlist/private:skidl_toolchain.bzl", "skidl_toolchain")
load("//netlist/private:toolchains.bzl", "helpers_toolchain", "unsupported_platform_toolchain")

# --@hdlf_rules_netlist//netlist/toolchains:use_stub swaps every tool for the stub.
# swap_test sets it with a transition. A tool toolchain honors it by
# carrying target_settings = [":stub_off"], and its stub twin
# target_settings = [":stub_on"].
bool_flag(
    name = "use_stub",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_on",
    flag_values = {":use_stub": "true"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_off",
    flag_values = {":use_stub": "false"},
    visibility = ["//visibility:public"],
)

helpers_toolchain(
    name = "helpers_impl",
    compare = "//netlist/private/detcompare",
    launcher = "//netlist/private/launcher",
    swapcheck = "//netlist/private/swapcheck",
)

# The helpers run on Linux x86_64 only in v1 (spec P1). The outputs of the
# rules are files for any platform, so the target platform is not
# constrained here; issue #6 adds the analysis-time check for other hosts.
toolchain(
    name = "helpers",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":helpers_impl",
    toolchain_type = "//netlist:helpers_toolchain_type",
)

# Any other execution platform: Bazel tries toolchains in the order they
# are registered, and MODULE.bazel registers this one last, so it is
# picked only where the one above does not match. Its analysis fails with
# a message that says which platform is supported (spec P1).
unsupported_platform_toolchain(
    name = "unsupported_impl",
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

toolchain(
    name = "unsupported",
    toolchain = ":unsupported_impl",
    toolchain_type = "//netlist:helpers_toolchain_type",
)

# The SKiDL toolchain (issue #9): SKiDL 3.0.0 on CPython 3.12 with the
# pinned KiCad 9.0.9 symbol libraries, the same that hdlf_rules_kicad uses.
skidl_toolchain(
    name = "skidl_impl",
    runner = "//netlist/private/skidl_runner:runner",
    symbols = "@kicad_libs//:symbols",
)

# Its swap_test twin: the stub in place of the runner.
skidl_toolchain(
    name = "skidl_stub_impl",
    runner = "//netlist/private/stub",
    symbols = "@kicad_libs//:symbols",
)

toolchain(
    name = "skidl",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":stub_off"],
    toolchain = ":skidl_impl",
    toolchain_type = "//netlist:skidl_toolchain_type",
)

toolchain(
    name = "skidl_stub",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":stub_on"],
    toolchain = ":skidl_stub_impl",
    toolchain_type = "//netlist:skidl_toolchain_type",
)

# Off Linux x86_64, the same message as the helpers' (spec P1), rather
# than a toolchain resolution error. MODULE.bazel registers it last.
toolchain(
    name = "skidl_unsupported",
    toolchain = ":unsupported_impl",
    toolchain_type = "//netlist:skidl_toolchain_type",
)
