#
# The Bazel Central Registry presubmit builds this module against the
# published hdlf_rules_netlist archive. `.bcr/presubmit.yml` names it by the
# `module_path: "integration"` key.
#
# The version below and the override are both replaced by the registry
# presubmit, which points the dependency at the release being published.
# Locally the override makes the module resolve to the parent directory, so
# `cd integration && bazel test //...` exercises the working tree.
module(
    name = "hdlf_rules_netlist_integration",
    version = "0.0.0",
)

bazel_dep(name = "hdlf_rules_netlist", version = "0.0.0")
local_path_override(
    module_name = "hdlf_rules_netlist",
    path = "..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")

# hdlf_rules_netlist's own override does not reach this module: overrides
# apply in the root module only. The same pinned commit of hdlf_rules_kicad
# (issue #8).
bazel_dep(name = "hdlf_rules_kicad", version = "0.0.0")

# The same pin as MODULE.bazel and README.md; change all three together.
archive_override(
    module_name = "hdlf_rules_kicad",
    integrity = "sha256-bz9RwwNoS0kCPESYe+qbysvlvuv9rVQpqbeqZ+Qj91U=",
    strip_prefix = "bazel_rules_kicad-ecd6ae9329a7830c8f7144db88b5d2bbb24041e9",
    urls = ["https://github.com/filmil/bazel_rules_kicad/archive/ecd6ae9329a7830c8f7144db88b5d2bbb24041e9.tar.gz"],
)

# Under Bazel 8, a py_binary of rules_python (hdlf_rules_netlist's SKiDL
# runner) asks for a C++ toolchain, though it compiles nothing; Bazel 9 does
# not. A user brings one: here the self-contained zig toolchain, as this
# module, like hdlf_rules_netlist's own, finds none on the host (.bazelrc).
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig_toolchains, "zig_sdk")

register_toolchains("@zig_sdk//toolchain:linux_amd64_gnu.2.31")
