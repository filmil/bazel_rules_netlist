# SPDX-License-Identifier: Apache-2.0
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//netlist/private"],
)

# The toolchain type of this module's own Go helpers: the launcher that
# every action runs through, and the stub and checker of swap_test.
toolchain_type(
    name = "helpers_toolchain_type",
    visibility = ["//visibility:public"],
)

# The SKiDL toolchain (issue #9): the SKiDL runner, on a hermetic Python,
# and the KiCad symbol libraries it reads. Its ToolchainInfo has the tool
# "skidl" for run_tool and SkidlToolchainInfo as `skidl`.
toolchain_type(
    name = "skidl_toolchain_type",
    visibility = ["//visibility:public"],
)

exports_files(
    ["defs.bzl"],
    visibility = ["//docs:__pkg__"],
)
