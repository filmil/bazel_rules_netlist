#
# The Bazel Central Registry presubmit builds this module against the
# published rules_netlist archive. `.bcr/presubmit.yml` names it by the
# `module_path: "integration"` key.
#
# The version below and the override are both replaced by the registry
# presubmit, which points the dependency at the release being published.
# Locally the override makes the module resolve to the parent directory, so
# `cd integration && bazel test //...` exercises the working tree.
module(
    name = "rules_netlist_integration",
    version = "0.0.0",
)

bazel_dep(name = "rules_netlist", version = "0.0.0")
local_path_override(
    module_name = "rules_netlist",
    path = "..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")

# rules_netlist's own override does not reach this module: overrides apply in
# the root module only. The same pinned commit of rules_kicad (issue #8).
bazel_dep(name = "rules_kicad", version = "0.0.0")

# The same pin as MODULE.bazel and README.md; change all three together.
archive_override(
    module_name = "rules_kicad",
    integrity = "sha256-L/dRAnTaCchSN66G81ijmGUiDzIUcU3DAy8RpNsaDMY=",
    strip_prefix = "bazel_rules_kicad-eda301dc59f9c29bd4fe2460bdd521eb9253a745",
    urls = ["https://github.com/filmil/bazel_rules_kicad/archive/eda301dc59f9c29bd4fe2460bdd521eb9253a745.tar.gz"],
)
