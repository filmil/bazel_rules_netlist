#
# The example consumer. It uses only the public API of rules_netlist, as a
# user of the published module would. The e2e circuit arrives with
# skidl_netlist (milestone M6).
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_netlist//netlist:defs.bzl", "RULES_NETLIST_API_VERSION")

# The public packages load and build: the rules, and the root package
# with the --@rules_netlist//:tools flag that every user's build reads.
build_test(
    name = "public_api_builds",
    size = "small",
    targets = [
        "@rules_netlist//:tools",
        "@rules_netlist//:tools_prebuilt",
        "@rules_netlist//:tools_source",
        "@rules_netlist//netlist:defs",
    ],
)

# The module resolved here is the one this consumer was written for.
write_file(
    name = "api_version",
    out = "api_version.txt",
    content = [
        RULES_NETLIST_API_VERSION,
        "",
    ],
)

diff_test(
    name = "api_version_test",
    size = "small",
    file1 = ":api_version",
    file2 = "expected_api_version.txt",
)
