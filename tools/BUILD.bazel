# Development tools. They use the module's dev dependencies, so they live
# apart from the packages a user of the module loads.
load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")

# bazel run //tools:buildifier
buildifier(
    name = "buildifier",
    # Lint fixtures are deliberately bad; formatting would move their lines.
    exclude_patterns = ["./tools/lint/testdata/*"],
    lint_mode = "warn",
    mode = "fix",
)

# bazel run //tools:buildifier_check: fails on any file that is not formatted.
buildifier(
    name = "buildifier_check",
    # Lint fixtures are deliberately bad; formatting would move their lines.
    exclude_patterns = ["./tools/lint/testdata/*"],
    lint_mode = "warn",
    mode = "check",
)

# bazel run //tools:mirror: checks the mirrored wheels (tools/mirror).
alias(
    name = "mirror",
    actual = "//tools/mirror",
)

# bazel run //tools:requirements.update: writes requirements_lock.txt from
# requirements.in, binary wheels only, each with its hash.
compile_pip_requirements(
    name = "requirements",
    src = "//:requirements.in",
    extra_args = [
        "--allow-unsafe",
        "--pip-args=--only-binary=:all:",
    ],
    python_version = "3.12",
    requirements_txt = "//:requirements_lock.txt",
    # Its test (that the lock is current) fetches from PyPI, so it does not
    # run with the other tests.
    tags = ["manual"],
)
